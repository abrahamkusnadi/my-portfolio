---
import Section from "./Section.astro";
import type { SkillCategory } from "@types";

interface Props {
  skills: SkillCategory[];
}

const { skills } = Astro.props;

const cardThemes = [
  { headerBg: "bg-[#2563EB]", textColor: "text-white" }, // Blue
  { headerBg: "bg-[#10B981]", textColor: "text-white" }, // Emerald
  { headerBg: "bg-[#8B5CF6]", textColor: "text-white" }, // Violet (System Modeling)
  { headerBg: "bg-[#F59E0B]", textColor: "text-black" }, // Amber
  { headerBg: "bg-[#EC4899]", textColor: "text-white" }, // Rose
];
---

<Section text="Technical Skills & Stack" href="skills" badge="// SKILLS">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      skills.map((skillGroup, index) => {
        const theme = cardThemes[index % cardThemes.length];
        const isWideCard = index === skills.length - 1 && skills.length % 2 !== 0;

        return (
          <div
            class={`neo-card flex flex-col justify-between overflow-hidden bg-white ${
              isWideCard ? "md:col-span-2" : ""
            }`}
          >
            <!-- Card Header -->
            <div class={`${theme.headerBg} ${theme.textColor} px-5 py-3.5 border-b-2 border-black flex items-center justify-between`}>
              <h3 class="font-serif text-lg font-black uppercase tracking-wider">
                {skillGroup.title}
              </h3>
              <span class="font-mono text-xs font-bold px-2 py-0.5 border border-black bg-white text-black shadow-[1px_1px_0px_#000]">
                0{index + 1}
              </span>
            </div>

            <!-- Card Body / Skill Tags -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div class={`grid grid-cols-1 ${isWideCard ? "sm:grid-cols-3" : "sm:grid-cols-2"} gap-2.5`}>
                {skillGroup.items.map((item) => (
                  <div class="flex items-center gap-2 p-2 rounded border border-black/20 bg-gray-50/70 hover:bg-[#FDE047]/40 hover:border-black transition-colors">
                    <span class="w-2 h-2 bg-[#2563EB] border border-black shrink-0"></span>
                    <span class="font-mono text-xs font-bold text-gray-900 leading-tight">
                      {item}
                    </span>
                  </div>
                ))}
              </div>

              <!-- Bottom decorative strip -->
              <div class="mt-4 pt-3 border-t border-dashed border-gray-200 flex items-center justify-between font-mono text-[11px] text-gray-500">
                <span>Enterprise &amp; Academic verified</span>
                <span class="text-black font-bold">&check; Production Ready</span>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Section>
