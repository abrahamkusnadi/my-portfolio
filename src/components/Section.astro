---
interface Props {
  text: string;
  href: string;
  badge?: string;
}

const { text, href, badge } = Astro.props;
---

<section id={href} class="scroll-mt-24">
  <div class="flex items-center gap-3 mb-8">
    <div class="inline-flex items-center font-mono text-xs font-black uppercase bg-[#2563EB] text-white px-2.5 py-1 border-2 border-black shadow-[2px_2px_0px_#000]">
      {badge ? badge : "// " + href.toUpperCase()}
    </div>
    <h2 class="font-serif text-2xl sm:text-3xl font-black uppercase tracking-tight text-black">
      {text}
    </h2>
    <div class="flex-1 border-b-2 border-black border-dashed"></div>
  </div>
  <slot />
</section>
