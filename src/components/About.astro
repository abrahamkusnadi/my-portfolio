---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name, highlights } = Astro.props;
---

<Section text="About Me" href="about" badge="// ABOUT">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Left Narrative Content -->
    <div class="lg:col-span-8 neo-card p-6 sm:p-8 bg-white flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        {
          Array.isArray(description) ? (
            description.map((paragraph) => (
              <p class="text-sm sm:text-base leading-relaxed text-gray-800 text-justify sm:text-left font-sans">
                {paragraph}
              </p>
            ))
          ) : (
            <p class="text-sm sm:text-base leading-relaxed text-gray-800 text-justify sm:text-left font-sans">
              {description}
            </p>
          )
        }
      </div>

      <!-- Highlights / Focus Areas -->
      <div>
        <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">
          CORE FOCUS &amp; COMPETENCIES:
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            highlights?.map((item) => (
              <span class="neo-badge bg-[#FDE047] text-black">
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Quick Bio Meta Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t-2 border-black border-dashed font-mono text-xs">
        <div>
          <span class="block text-gray-500 text-[11px]">LOCATION</span>
          <span class="font-bold text-black">Jakarta, ID</span>
        </div>
        <div>
          <span class="block text-gray-500 text-[11px]">EDUCATION</span>
          <span class="font-bold text-black">BINUS University</span>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <span class="block text-gray-500 text-[11px]">STATUS</span>
          <span class="font-bold text-[#2563EB]">Undergraduate &amp; Intern</span>
        </div>
      </div>
    </div>

    <!-- Right Profile / Sticker Card -->
    <div class="lg:col-span-4 flex justify-center">
      <div class="neo-card bg-[#F4F5F7] p-3 max-w-[280px] w-full rotate-1 hover:rotate-0 transition-transform duration-200">
        <!-- Top Tape Decor -->
        <div class="w-16 h-4 bg-yellow-200/90 border border-black/30 mx-auto -mt-5 mb-2 shadow-sm"></div>

        <div class="border-2 border-black overflow-hidden bg-white">
          <Image
            class="w-full h-72 object-cover object-top"
            src={image}
            width={280}
            height={320}
            alt={name}
          />
        </div>

        <div class="mt-3 text-center">
          <p class="font-serif font-black text-sm uppercase text-black">{name}</p>
          <p class="font-mono text-[11px] text-[#2563EB] font-bold">Backend Developer &amp; Mentor</p>
        </div>
      </div>
    </div>
  </div>
</Section>
