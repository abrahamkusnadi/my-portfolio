---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience" badge="// CAREER">
  <div class="space-y-6">
    {
      experience.map(({ company, position, startDate, endDate, summary }, index) => (
        <div class="neo-card bg-white p-6 sm:p-8 relative">
          <!-- Top Bar with Company and Period -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-5 border-b-2 border-black border-dashed">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#A3E635] text-black border border-black shadow-[1px_1px_0px_#000]">
                  EXP 0{index + 1}
                </span>
                <h3 class="font-serif text-2xl font-black uppercase text-black">
                  {company}
                </h3>
              </div>
              <h4 class="font-mono text-sm sm:text-base font-bold text-[#2563EB]">
                {position}
              </h4>
            </div>

            <div class="inline-flex self-start sm:self-center font-mono text-xs font-bold bg-gray-100 text-gray-800 px-3 py-1.5 border border-black shadow-[2px_2px_0px_#000]">
              {startDate} — {endDate}
            </div>
          </div>

          <!-- Description / Responsibilities -->
          {Array.isArray(summary) ? (
            <ul class="space-y-2.5">
              {summary.map((point) => (
                <li class="flex items-start gap-3 text-sm sm:text-base text-gray-800 font-sans leading-relaxed">
                  <span class="mt-1.5 w-2 h-2 rounded-none bg-[#2563EB] border border-black shrink-0"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm sm:text-base text-gray-800 font-sans leading-relaxed">
              {summary}
            </p>
          )}
        </div>
      ))
    }
  </div>
</Section>
