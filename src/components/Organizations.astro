---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { OrganizationProps } from "@types";

interface Props {
  organizations: OrganizationProps[];
}

const { organizations } = Astro.props;
---

<Section text="Organizational Experience" href="organizations" badge="// COMMUNITY">
  <div class="space-y-8">
    {
      organizations.map((org: OrganizationProps) => {
        const { name, period, summary, roles, image, linkPreview, linkSource } = org;

        return (
          <div class="neo-card bg-white p-6 sm:p-8">
            <!-- Org Header -->
            <div class="flex flex-col sm:flex-row sm:items-start gap-5 pb-6 border-b-2 border-black border-dashed">
              <div class="h-16 w-16 sm:h-20 sm:w-20 shrink-0 border-2 border-black bg-gray-50 p-2 shadow-[2px_2px_0px_#000] overflow-hidden flex items-center justify-center">
                <Image
                  class="h-full w-full object-contain"
                  src={image}
                  alt={name}
                  width={80}
                  height={80}
                />
              </div>

              <div class="flex-1">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <h3 class="font-serif text-2xl font-black uppercase text-black">
                    {name}
                  </h3>
                  {period && (
                    <span class="font-mono text-xs font-bold bg-[#FDE047] text-black px-2.5 py-1 border border-black shadow-[1.5px_1.5px_0px_#000]">
                      {period}
                    </span>
                  )}
                </div>
                <p class="text-sm sm:text-base text-gray-700 leading-relaxed font-sans">
                  {summary}
                </p>
              </div>
            </div>

            <!-- Sub-roles / Initiatives -->
            {roles && roles.length > 0 && (
              <div class="mt-6 space-y-5">
                <h4 class="font-mono text-xs font-bold uppercase text-gray-500 tracking-wider">
                  ROLES &amp; CONTRIBUTIONS:
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {roles.map((role) => (
                    <div class={`p-4 border-2 border-black bg-gray-50/60 shadow-[2px_2px_0px_#000] flex flex-col justify-between ${roles.length === 1 ? "md:col-span-2" : ""}`}>
                      <div>
                        <div class="flex items-start justify-between gap-2 mb-1.5">
                          <h5 class="font-serif text-base font-bold text-black leading-snug">
                            {role.title}
                          </h5>
                        </div>
                        <span class="inline-block font-mono text-[11px] font-bold text-[#2563EB] mb-2.5">
                          {role.periodRole}
                        </span>
                        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans">
                          {role.description}
                        </p>
                      </div>

                      {role.certificateLink && (
                        <div class="mt-3 pt-3 border-t border-black/10">
                          <a
                            href={role.certificateLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-black hover:text-[#2563EB] transition-colors"
                          >
                            <span>VIEW CERTIFICATE</span>
                            <span>&nearr;</span>
                          </a>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Org Links if available -->
            {(linkSource || linkPreview) && (
              <div class="mt-6 pt-4 border-t-2 border-dashed border-gray-200 flex flex-wrap gap-3">
                {linkSource && (
                  <a
                    href={linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="neo-btn bg-white text-black hover:bg-gray-100 text-xs py-1.5 px-3"
                  >
                    View Source &nearr;
                  </a>
                )}
                {linkPreview && (
                  <a
                    href={linkPreview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="neo-btn bg-[#A3E635] text-black hover:bg-[#86efac] text-xs py-1.5 px-3"
                  >
                    Visit Website &nearr;
                  </a>
                )}
              </div>
            )}
          </div>
        );
      })
    }
  </div>
</Section>
