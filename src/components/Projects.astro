---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects" badge="// WORK">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      projects.map(({ name, summary, image, tags, linkPreview, linkSource }, index) => {
        return (
          <div class="neo-card-interactive flex flex-col justify-between overflow-hidden bg-white">
            <!-- Project Image Container -->
            <div class="relative h-52 sm:h-56 w-full border-b-2 border-black overflow-hidden bg-gray-100 group">
              <Image
                class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                src={image}
                alt={name}
                width={700}
                height={400}
              />
              <div class="absolute top-3 left-3 neo-badge bg-[#FDE047] text-black">
                PROJECT 0{index + 1}
              </div>
            </div>

            <!-- Content Area -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-serif text-xl sm:text-2xl font-black uppercase tracking-tight text-black mb-2.5">
                  {name}
                </h3>
                <p class="text-sm text-gray-700 leading-relaxed font-sans mb-4">
                  {summary}
                </p>

                <!-- Tech Tags -->
                {tags && tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-5">
                    {tags.map((tag) => (
                      <span class="font-mono text-[11px] font-bold px-2 py-0.5 border border-black bg-gray-100 text-gray-800 shadow-[1px_1px_0px_#000]">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Action Links -->
              <div class="pt-4 border-t-2 border-dashed border-gray-200 flex flex-wrap items-center gap-3">
                {linkSource && (
                  <a
                    href={linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="neo-btn bg-white text-black hover:bg-gray-100 text-xs py-1.5 px-3"
                  >
                    <span>SOURCE</span>
                    <span>&nearr;</span>
                  </a>
                )}
                {linkPreview && (
                  <a
                    href={linkPreview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="neo-btn bg-[#2563EB] text-white hover:bg-[#1D4ED8] text-xs py-1.5 px-3"
                  >
                    <span>PREVIEW</span>
                    <span>&nearr;</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Section>
