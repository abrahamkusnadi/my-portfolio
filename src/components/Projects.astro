---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
      const top = 98 + index * 40;
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
        >
          {/* PERUBAHAN 1: grid-rows-[auto_1fr], min-h-[500px], dan penambahan gap-6 untuk mobile */}
          <div class="bg-difu relative z-1 grid min-h-[500px] w-full grid-rows-[auto_1fr] gap-6 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-size-[128px] before:bg-repeat before:opacity-5 before:content-[''] sm:min-h-0 sm:grid-cols-2 sm:grid-rows-1 sm:gap-0 md:h-96">
            
            {/* PERUBAHAN 2: Menambahkan pb-4 (padding bottom) khusus di mobile agar ada nafas antara link dan gambar */}
            <div class="px-6 pt-12 pb-4 sm:pb-0">
              <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                {name}
              </h3>
              <p class="text-base text-neutral">{summary}</p>
              <div class="flex gap-5 pt-10 text-white">
                <a
                  href={linkSource}
                  target="_blank"
                  class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
                >
                  Source
                </a>
                <a
                  href={linkPreview}
                  target="_blank"
                  class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
                >
                  Preview
                </a>
              </div>
            </div>

            <div class="flex items-end justify-end overflow-hidden">
              {/* PERUBAHAN 3: Menambahkan max-h-[280px] untuk mobile agar gambar tidak terlalu raksasa saat ditarik ke atas */}
              <Image
                class="h-full w-[95%] max-h-[280px] rounded-ss-xl rounded-ee-2xl object-cover object-center sm:h-[85%] sm:max-h-none sm:w-full"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>